# Copy this file to .env before running `docker compose up --build`.
# .env is gitignored -- never commit real secrets into this file.

# ---------------------------------------------------------------- #
# Redis (the message queue)
# ---------------------------------------------------------------- #
REDIS_URL=redis://redis:6379/0

# ---------------------------------------------------------------- #
# Postgres (final storage for qualified, validated records)
# ---------------------------------------------------------------- #
POSTGRES_USER=enrich_app
POSTGRES_PASSWORD=change-me
POSTGRES_DB=enrichment
POSTGRES_HOST_PORT=5544
DATABASE_URL=postgresql://enrich_app:change-me@postgres:5432/enrichment

# ---------------------------------------------------------------- #
# seed_loader
# ---------------------------------------------------------------- #
# Drop your input .csv / .xlsx into ./data/input/ -- every file found
# there is loaded. The RBI Non-Scheduled Urban Co-operative Banks list
# is already there (non_scheduled_urban_coop_banks.csv).
DEFAULT_ENTITY_TYPE=bank
DEFAULT_SECTOR=BFSI
# seed_loader only ever seeds once per Redis instance (tracked via a
# marker key) so restarting/recreating other containers never silently
# duplicates the job batch. Set true to intentionally reseed (e.g. after
# replacing the input file) -- then set it back to false.
FORCE_RESEED=false

# ---------------------------------------------------------------- #
# crawler
# ---------------------------------------------------------------- #
CRAWLER_BATCH_SIZE=5
MAX_DOCUMENTS_PER_ENTITY=6
MAX_QUERIES_PER_ENTITY=6
MAX_RESULTS_PER_QUERY=5

# Optional: real search APIs. If both of a pair are set, that provider is
# used instead of the free DuckDuckGo fallback (see services/crawler/search.py).
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_ID=
BING_SEARCH_API_KEY=

# ---------------------------------------------------------------- #
# translator
# ---------------------------------------------------------------- #
TRANSLATOR_BATCH_SIZE=3
# Set to false to skip IndicTrans2 entirely (non-English pages/PDFs will
# then flow through un-translated -- extractor will simply find fewer
# matches on them, honestly reported as "N/A", never crashing).
TRANSLATION_ENABLED=true

# ---------------------------------------------------------------- #
# extractor / icp_scorer
# ---------------------------------------------------------------- #
EXTRACTOR_BATCH_SIZE=5
ICP_SCORER_BATCH_SIZE=10
# Override to point at a different scoring rules file if you mount one in.
SCORING_CONFIG_PATH=/app/config/scoring_rules.yaml

# ---------------------------------------------------------------- #
# db_writer
# ---------------------------------------------------------------- #
DB_WRITER_BATCH_SIZE=10
# true = re-run the pipeline and update rows already in the database with
# newer evidence; false (default) = never touch an existing verified row.
OVERWRITE_EXISTING=false

# ---------------------------------------------------------------- #
# orchestrator
# ---------------------------------------------------------------- #
ORCH_SWEEP_INTERVAL_S=20
# How long (ms) a message may sit un-acked before it's considered stuck.
ORCH_STUCK_IDLE_MS=120000
ORCH_MAX_RETRIES=3
ORCH_STATUS_PORT=8080
