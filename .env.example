# Template for .env -- copy to .env and fill in real values.
# .env itself is gitignored (never commit real secrets).

POSTGRES_USER=esds_app
POSTGRES_PASSWORD=change-me
POSTGRES_DB=esds_eip_dev
# Pick a port with nothing else already bound to it on the host. 5433 is the
# conventional "alternate postgres" port but collides if you (or an older
# setup) still has a non-Docker Postgres listening there -- Windows resolves
# localhost to whichever process bound the more specific 127.0.0.1 address,
# so a collision fails silently (you appear to connect fine, just to the
# wrong database) rather than erroring. 5434 avoids this ambiguity.
POSTGRES_HOST_PORT=5434

# Inside the Docker network, "postgres" is the service name -- always this
# host/port regardless of what POSTGRES_HOST_PORT is set to (that variable
# only controls the port exposed to your machine, e.g. for `psql` from the
# host, not how backend reaches postgres internally).
DATABASE_URL=postgresql://esds_app:change-me@postgres:5432/esds_eip_dev?schema=public
BACKEND_PORT=4000
CORS_ORIGIN=http://localhost:8080
JWT_SECRET=generate-a-real-32+char-secret-here
JWT_EXPIRES_IN=24h

# Admin seed -- optional, skipped (logged, not silently) if unset.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN2_FULLNAME=
SEED_ADMIN2_EMAIL=
SEED_ADMIN2_PASSWORD=

FRONTEND_HOST_PORT=8080

# Pipeline (optional)
PIPELINE_SERVICE_EMAIL=
PIPELINE_SERVICE_PASSWORD=
ANTHROPIC_API_KEY=
